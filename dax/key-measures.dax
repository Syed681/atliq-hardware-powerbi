// ============================================================
// ATLIQ HARDWARE - KEY DAX MEASURES
// Interview-Safe Portfolio Version
// ============================================================


// ============================================================
// 1. SALES & REVENUE
// ============================================================

MEASURE 'Key Measures'[GS $] =
    SUM(fact_actuals_estimates[gross_sales_amount])


MEASURE 'Key Measures'[NIS $] =
    SUM(fact_actuals_estimates[net_invoice_sales_amount])


MEASURE 'Key Measures'[Pre Invoice Deduction $] =
    [GS $] - [NIS $]


MEASURE 'Key Measures'[Post Invoice Deduction $] =
    SUM(fact_actuals_estimates[post_invoice_deductions_amount])


MEASURE 'Key Measures'[NS $] =
    SUM(fact_actuals_estimates[net_sales_amount])


// ============================================================
// 2. COST & GROSS MARGIN
// ============================================================

MEASURE 'Key Measures'[Manufacturing Cost $] =
    SUM(fact_actuals_estimates[manufacturing_cost])


MEASURE 'Key Measures'[Freight Cost $] =
    SUM(fact_actuals_estimates[freight_cost])


MEASURE 'Key Measures'[Other Cost $] =
    SUM(fact_actuals_estimates[other_cost])


MEASURE 'Key Measures'[Total COGS $] =
    [Manufacturing Cost $]
    + [Freight Cost $]
    + [Other Cost $]


MEASURE 'Key Measures'[GM $] =
    [NS $] - [Total COGS $]


MEASURE 'Key Measures'[GM %] =
    DIVIDE(
        [GM $],
        [NS $],
        0
    )


MEASURE 'Key Measures'[Quantity] =
    SUM(fact_actuals_estimates[Qty])


MEASURE 'Key Measures'[GM / Unit] =
    DIVIDE(
        [GM $],
        [Quantity],
        0
    )


// ============================================================
// 3. OPERATIONAL EXPENSE & PROFITABILITY
// ============================================================

MEASURE 'Key Measures'[Ads & Promotions $] =
    SUM(fact_actuals_estimates[ads_promotions])


MEASURE 'Key Measures'[Other Operational Expense $] =
    SUM(fact_actuals_estimates[other_operational_expense])


MEASURE 'Key Measures'[Operational Expense $] =
    (
        [Ads & Promotions $]
        + [Other Operational Expense $]
    ) * -1


MEASURE 'Key Measures'[Net Profit $] =
    [GM $] + [Operational Expense $]


MEASURE 'Key Measures'[Net Profit %] =
    DIVIDE(
        [Net Profit $],
        [NS $],
        0
    )


// ============================================================
// 4. FORECASTING
// ============================================================

MEASURE 'Key Measures'[Sales Qty] =
    CALCULATE(
        SUM(fact_actuals_estimates[Qty]),
        fact_actuals_estimates[date]
            <= MAX(LastSalesMonth[LastSalesMonth])
    )


MEASURE 'Key Measures'[Forecast Qty] =
    VAR LastSalesDate =
        MAX(LastSalesMonth[LastSalesMonth])

    RETURN
        CALCULATE(
            SUM(fact_forecast_monthly[forecast_quantity]),
            fact_forecast_monthly[date] <= LastSalesDate
        )


MEASURE 'Key Measures'[Net Error] =
    [Forecast Qty] - [Sales Qty]


MEASURE 'Key Measures'[Net Error %] =
    DIVIDE(
        [Net Error],
        [Forecast Qty],
        0
    )


MEASURE 'Key Measures'[ABS Error] =
    SUMX(
        DISTINCT(dim_date[month]),
        SUMX(
            DISTINCT(dim_product[product_code]),
            ABS([Net Error])
        )
    )


MEASURE 'Key Measures'[ABS Error %] =
    DIVIDE(
        [ABS Error],
        [Forecast Qty],
        0
    )


MEASURE 'Key Measures'[Forecast Accuracy %] =
    IF(
        [ABS Error %] <> BLANK(),
        1 - [ABS Error %],
        BLANK()
    )


MEASURE 'Key Measures'[Risk] =
    IF(
        [Net Error] > 0,
        "EI",
        IF(
            [Net Error] < 0,
            "OOS",
            BLANK()
        )
    )


// ============================================================
// 5. YEAR-OVER-YEAR ANALYSIS
// ============================================================

MEASURE 'Key Measures'[NS $ LY] =
    CALCULATE(
        [NS $],
        SAMEPERIODLASTYEAR(dim_date[date])
    )


MEASURE 'Key Measures'[GM % LY] =
    CALCULATE(
        [GM %],
        SAMEPERIODLASTYEAR(dim_date[date])
    )


MEASURE 'Key Measures'[Net Proft % LY] =
    CALCULATE(
        [Net Profit %],
        SAMEPERIODLASTYEAR(dim_date[date])
    )
